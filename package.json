{
  "name": "asterial",
  "version": "1.4.3",
  "private": true,
  "description": "ASTERIAL v1.4.3 — Precision real-time messaging, Orbits, Moments & Social Feed across Web & Android. Official Developer: Ritam Das | By X Huracan.",
  "author": "Ritam Das (By X Huracan)",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint src packages/core/src mobile/src",
    "typecheck": "tsc --noEmit && tsc -p packages/core/tsconfig.json --noEmit",
    "test": "tsx --test 'src/**/*.test.ts' 'packages/core/src/**/*.test.ts'",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "mobile:env": "node scripts/prepare-mobile-env.mjs",
    "mobile:env:strict": "node scripts/prepare-mobile-env.mjs --require-valid",
    "mobile:typecheck": "node scripts/prepare-mobile-env.mjs --if-missing && npm --prefix mobile run typecheck",
    "mobile:test": "npm --prefix mobile test",
    "check": "npm run version:check && npm run typecheck && npm run mobile:typecheck && npm run lint && npm run test && npm run mobile:test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
