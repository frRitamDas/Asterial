# ASTERIAL v1.2 — Environment Configuration Example
# Copy this file to .env.local and supply your own values.
# NEVER commit real secrets, keystores, or SUPABASE_SERVICE_ROLE_KEY to version control.

# Public Supabase client configuration (safe for browser with strict RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Public canonical application URL (used for auth redirect callbacks & Android live shell)
NEXT_PUBLIC_APP_URL=https://asterial.vercel.app

# Server-only privileged key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Comma-separated SHA-256 certificate fingerprints for Android App Links (/.well-known/assetlinks.json)
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
