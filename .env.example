# ASTERIAL — Environment Configuration Example (Web + React Native Mobile)
# Copy this file to .env.local and supply your own values.
# NEVER commit real secrets, keystores, or SUPABASE_SERVICE_ROLE_KEY to version control.

# Shared public Supabase client configuration (enforced by PostgreSQL 17 RLS on all tables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Public canonical website URL (used for SSR auth redirect callbacks)
NEXT_PUBLIC_APP_URL=https://asterial.vercel.app

# Server-only privileged key for Next.js API routes (NEVER prefix with NEXT_PUBLIC_ or bundle into mobile/)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Comma-separated SHA-256 certificate fingerprints for Android App Links (/.well-known/assetlinks.json)
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
