# ASTERIAL v1.1 — Environment Configuration Example
# Copy this file to .env.local and supply your own values.
# NEVER commit real secrets or SUPABASE_SERVICE_ROLE_KEY to version control.

# Public Supabase client configuration (safe for browser with strict RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Public canonical application URL (used for auth redirect callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only privileged key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
